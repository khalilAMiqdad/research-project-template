# Normalise line endings; keep UTF-8 text diffable (Arabic included)
*                 text=auto eol=lf
*.md              text diff=markdown
*.csv             text
*.py              text diff=python
*.R               text
*.Rmd             text
*.qmd             text
*.do              text
*.sps             text
*.yml             text
*.yaml            text
*.bat             text eol=crlf
*.ps1             text eol=crlf

# ---- Git LFS: large NON-SENSITIVE binaries only (see DATA_SECURITY.md §3) ----
*.pdf             filter=lfs diff=lfs merge=lfs -text
*.docx            filter=lfs diff=lfs merge=lfs -text
*.pptx            filter=lfs diff=lfs merge=lfs -text
*.xlsx            filter=lfs diff=lfs merge=lfs -text
*.png             filter=lfs diff=lfs merge=lfs -text
*.jpg             filter=lfs diff=lfs merge=lfs -text
*.jpeg            filter=lfs diff=lfs merge=lfs -text
*.tif             filter=lfs diff=lfs merge=lfs -text

# Approved de-identified datasets and public datasets
02_data/analysis_ready/approved_deid/*.csv      filter=lfs diff=lfs merge=lfs -text
02_data/analysis_ready/approved_deid/*.sav      filter=lfs diff=lfs merge=lfs -text
02_data/analysis_ready/approved_deid/*.dta      filter=lfs diff=lfs merge=lfs -text
02_data/analysis_ready/approved_deid/*.parquet  filter=lfs diff=lfs merge=lfs -text
02_data/analysis_ready/approved_deid/*.rds      filter=lfs diff=lfs merge=lfs -text
07_outputs/datasets/**/*.csv                    filter=lfs diff=lfs merge=lfs -text
07_outputs/datasets/**/*.sav                    filter=lfs diff=lfs merge=lfs -text
07_outputs/datasets/**/*.dta                    filter=lfs diff=lfs merge=lfs -text
07_outputs/datasets/**/*.zip                    filter=lfs diff=lfs merge=lfs -text

# Keep documentation files out of LFS even inside LFS folders
**/README.md      -filter -diff -merge text
