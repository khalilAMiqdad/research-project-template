# Copy to ".env" in the repository root (git-ignored) and fill in locally.
# NEVER commit the real .env file.

# Absolute path to this project's folder in the SECURE storage (not inside the repo).
# Must contain: raw/ cleaned/ processed/ analysis_ready/ restricted/
DATA_ROOT=

# Optional: survey platform API credentials (read by scripts via environment variables)
SURVEY_PLATFORM_URL=
SURVEY_PLATFORM_TOKEN=
